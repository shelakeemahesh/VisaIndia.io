# Application Environment
APP_ENV=development
APP_PORT=8080
FRONTEND_PORT=5173

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=visasetu_db
POSTGRES_USER=visasetu_user
POSTGRES_PASSWORD=visasetu_secure_dev_pass

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=visasetu_forms
MONGO_USER=visasetu_mongo
MONGO_PASSWORD=visasetu_mongo_dev_pass

# Redis Cache & Locking
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Messaging
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=visasetu_rabbit
RABBITMQ_PASSWORD=visasetu_rabbit_dev_pass
